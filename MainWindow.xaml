<Window x:Class="Pano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pano" Width="460" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Icon="app.ico"
        Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Window.Resources>
    <DataTemplate x:Key="ClipTpl">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding NumberText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                   VerticalAlignment="Top" Margin="2,2,0,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" LineHeight="20"
                     Visibility="{Binding TextVisibility}"/>
          <Border Visibility="{Binding ImageVisibility}" HorizontalAlignment="Left" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Background="#0C0F16" Padding="2">
            <Image Source="{Binding Thumb}" MaxHeight="96" MaxWidth="330" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,-2,0,0">
          <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Click="Pin_Click" ToolTip="Sabitle (Ctrl+P)" Opacity="0">
            <Path Data="{StaticResource IcoPin}" Style="{StaticResource IconPath}"/>
          </Button>
          <Button x:Name="DelBtn" Style="{StaticResource IconBtn}" Click="Del_Click" ToolTip="Sil (Shift+Del)" Opacity="0">
            <Path Data="{StaticResource IcoTrash}" Style="{StaticResource IconPath}"/>
          </Button>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="PinBtn" Property="Opacity" Value="1"/>
          <Setter TargetName="DelBtn" Property="Opacity" Value="1"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Pinned}" Value="True">
          <Setter TargetName="PinBtn" Property="Opacity" Value="1"/>
          <Setter TargetName="PinBtn" Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="PinBtn" Property="ToolTip" Value="Sabitlemeyi kaldır (Ctrl+P)"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <!-- shadow layer kept separate so text stays crisp -->
    <Border CornerRadius="14" Background="{StaticResource BgBrush}">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/></Border.Effect>
    </Border>
    <Border CornerRadius="14" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- search -->
        <Grid Margin="16,14,12,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Path Data="{StaticResource IcoSearch}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9" Width="16" Height="16" Stretch="Uniform"
                StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Center"/>
          <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Panoda ara…" Margin="10,0,8,0" TextChanged="Search_TextChanged"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="PausedBadge" Background="#3A2A12" CornerRadius="10" Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed">
              <TextBlock Text="Duraklatıldı" Foreground="#FBBF24" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="CountTxt" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,8">
          <RadioButton x:Name="FAll" Content="Tümü" Style="{StaticResource Chip}" GroupName="f" IsChecked="True" Checked="Filter_Checked"/>
          <RadioButton x:Name="FText" Content="Metin" Style="{StaticResource Chip}" GroupName="f" Checked="Filter_Checked"/>
          <RadioButton x:Name="FImage" Content="Görsel" Style="{StaticResource Chip}" GroupName="f" Checked="Filter_Checked"/>
          <RadioButton x:Name="FFiles" Content="Dosya" Style="{StaticResource Chip}" GroupName="f" Checked="Filter_Checked"/>
          <RadioButton x:Name="FPinned" Content="Sabitlenen" Style="{StaticResource Chip}" GroupName="f" Checked="Filter_Checked"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <ListBox x:Name="List" ItemTemplate="{StaticResource ClipTpl}" Background="Transparent" BorderThickness="0" Padding="6,6,4,6"
                     Foreground="{StaticResource FgBrush}" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseLeftButtonUp="List_MouseLeftButtonUp"/>
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" Visibility="Collapsed">
              <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock x:Name="EmptyBody" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="300"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- footer -->
        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
          <WrapPanel x:Name="Hints" TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
